RUBY_ENV=development

# Docker image tag used by docker-compose.yml. Pinned to a version by default
# so redeploys are reproducible; set to "latest" (or another tag) to override.
# IMAGE_TAG=1.0.0

# ==================== SociaVault API ====================
# Get your API key from: https://sociavault.com/dashboard
SOCIAVAULT_API_KEY=sk_live_your_api_key_here

# Dry run: true = every search is a no-op. The whole pipeline still runs
# (dashboard, listings, alert emails) but nothing is sent to SociaVault and no
# credits are spent. Handy for trying the UI or checking a change. The header
# shows a "Dry run" badge while it is on, and the credit-balance read still
# happens because it is free.
DRY_RUN=false

# ==================== Email Configuration ====================
# Sender ("From") address for alert emails. Alert recipients are set per
# saved search (the `email` field), not globally.
EMAIL_FROM=marketplace-alerts@example.com

# SMTP Configuration for Gmail:
#   1. Enable 2-factor authentication on your Gmail account
#   2. Generate an app password at: https://myaccount.google.com/apppasswords
#   3. Use the app password below (16 characters, no spaces)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# For other email providers, adjust SMTP settings accordingly:
#   SendGrid: smtp.sendgrid.net, port 587, user: apikey
#   AWS SES:  email-smtp.REGION.amazonaws.com, port 587
