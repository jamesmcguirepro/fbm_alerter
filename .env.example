# ==================== SociaVault API ====================
# Get your API key from: https://sociavault.com/dashboard
SOCIAVAULT_API_KEY=sk_live_your_api_key_here

# ==================== Email Configuration ====================
# Sender email address
EMAIL_FROM=marketplace-alerts@example.com

# Recipient email addresses (comma-separated)
EMAIL_TO=user@example.com,another@example.com

# SMTP Configuration for Gmail:
#   1. Enable 2-factor authentication on your Gmail account
#   2. Generate an app password at: https://myaccount.google.com/apppasswords
#   3. Use the app password below (16 characters, no spaces)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# For other email providers, adjust SMTP settings accordingly:
#   SendGrid: smtp.sendgrid.net, port 587, user: apikey
#   AWS SES:  email-smtp.REGION.amazonaws.com, port 587

# ==================== Database ====================
DB_PATH=./marketplace_monitor.db

# ==================== Scheduling ====================
# Interval for daemon mode (used with 'ruby marketplace_monitor.rb daemon')
# Format: 30m, 1h, 15m, etc.
SCHEDULE_INTERVAL=30m

# ==================== Searches ====================
# Format: query|latitude|longitude|min_price|max_price|[radius_km]|[condition]|[delivery_method]
# Multiple searches separated by semicolons
# 
# condition options: new, used_like_new, used_good, used_fair
# delivery_method options: all, local_pickup, shipping
#
# Example searches:
#   - Bike within $100-500 in Austin, 65km radius
#   - Mountain bike within $50-300 in NYC, 25km radius (shipping only)

SEARCHES=bike|30.2677|-97.7475|100|500|65;mountain bike|40.7128|-74.0060|50|300|25|used_good|shipping

# To find lat/lng for a city:
#   - Use Google Maps and click on a location
#   - Or check: https://docs.sociavault.com/api-reference/facebook-marketplace/location-search
