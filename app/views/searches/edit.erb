<h1>Edit search</h1>

<p class="page-note">
  Saving forks a new search and pauses this one, so existing listings keep the search that found them.
</p>

<%= form_errors(@search) %>

<div class="form">
  <form action="/searches/<%= @search.id %>" method="post">
    <input type="hidden" name="_method" value="patch">
    <div class="field">
      <label>Name</label>
      <input type="text" name="name" value="<%= escape_html(@search.name || '') %>">
    </div>
    <div class="field">
      <label>Query</label>
      <input type="text" name="query" value="<%= escape_html(@search.query) %>" required>
    </div>
    <%= erb :'searches/_location_fields', layout: false %>
    <div class="field">
      <label>Radius (miles) <span class="label-hint">1–500</span></label>
      <input type="number" min="1" max="500" name="radius_mi" value="<%= escape_html(@search&.radius_mi || 40) %>" required>
    </div>
    <div class="field">
      <label>Min price</label>
      <input type="number" name="min_price" value="<%= escape_html(@search.min_price || '') %>">
    </div>
    <div class="field">
      <label>Max price</label>
      <input type="number" name="max_price" value="<%= escape_html(@search.max_price || '') %>">
    </div>
    <div class="field">
      <label>Condition</label>
      <select name="condition">
        <option value="">Any</option>
        <option value="new" <%= @search.condition == 'new' ? 'selected' : nil %>>New</option>
        <option value="used_like_new" <%= @search.condition == 'used_like_new' ? 'selected' : nil %>>Used like new</option>
        <option value="used_good" <%= @search.condition == 'used_good' ? 'selected' : nil %>>Used good</option>
        <option value="used_fair" <%= @search.condition == 'used_fair' ? 'selected' : nil %>>Used fair</option>
      </select>
    </div>
    <div class="field">
      <label>Delivery method</label>
      <select name="delivery_method">
        <option value="">Any</option>
        <option value="all" <%= @search.delivery_method == 'all' ? 'selected' : nil %>>All</option>
        <option value="local_pickup" <%= @search.delivery_method == 'local_pickup' ? 'selected' : nil %>>Local pickup</option>
        <option value="shipping" <%= @search.delivery_method == 'shipping' ? 'selected' : nil %>>Shipping</option>
      </select>
    </div>
    <div class="field">
      <label>Email address</label>
      <input type="email" name="email" value="<%= escape_html(@search.email) %>" required>
    </div>
    <div class="field field-checkbox">
      <input type="checkbox" name="active" id="active" <%= @search.active ? 'checked' : nil %>>
      <label for="active">Active (paused searches are skipped on run)</label>
    </div>
    <div class="actions">
      <button type="submit" class="button button--primary">Save changes</button>
      <a href="/searches" class="button button--secondary">Cancel</a>
    </div>
  </form>
</div>
