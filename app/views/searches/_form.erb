<%#
  Locals:
    search - SavedSearch instance
    location_query - string for the location query field
    action - form action path
    method - HTTP method (:post or :patch)
    title - page title
    submit_text - submit button label
    page_note - optional note (string or nil)
    name_label - name input label (default: "Name")
    name_hint - optional hint for name (nil for edit)
    query_hint - optional hint for query (nil for edit)
    email_hint - optional hint for email (nil for edit)
    default_radius - radius default value (SavedSearch::DEFAULT_RADIUS_MI)
    active_checkbox - whether to show the active checkbox (false for new)
%>

<h1><%= escape_html(title) %></h1>

<% if page_note %>
  <p class="page-note"><%= escape_html(page_note) %></p>
<% end %>

<%= form_errors(search) %>

<div class="form">
  <form action="<%= escape_html(action) %>" method="post">
    <% if method == :patch %>
      <input type="hidden" name="_method" value="patch">
    <% end %>
    <div class="field">
      <label><%= escape_html(name_label) %><% if name_hint %><span class="label-hint">(<%= escape_html(name_hint) %>)</span><% end %></label>
      <input type="text" name="name" value="<%= escape_html(search&.name || '') %>">
    </div>
    <div class="field">
      <label>Query<% if query_hint %><span class="label-hint">e.g. <%= escape_html(query_hint) %></span><% end %></label>
      <input type="text" name="query" value="<%= escape_html(search&.query || '') %>" required>
    </div>
    <%= erb :'searches/_location_fields', layout: false, locals: { search: search, location_query: location_query } %>
    <div class="field">
      <label>Radius (miles) <span class="label-hint">1–500</span></label>
      <input type="number" min="1" max="500" name="radius_mi" value="<%= escape_html(search&.radius_mi || default_radius) %>" required>
    </div>
    <div class="field">
      <label>Min price</label>
      <input type="number" name="min_price" value="<%= escape_html(search&.min_price || '') %>">
    </div>
    <div class="field">
      <label>Max price</label>
      <input type="number" name="max_price" value="<%= escape_html(search&.max_price || '') %>">
    </div>
    <div class="field">
      <label>Condition</label>
      <select name="condition">
        <option value="">Any</option>
        <option value="new" <%= search&.condition == 'new' ? 'selected' : nil %>>New</option>
        <option value="used_like_new" <%= search&.condition == 'used_like_new' ? 'selected' : nil %>>Used like new</option>
        <option value="used_good" <%= search&.condition == 'used_good' ? 'selected' : nil %>>Used good</option>
        <option value="used_fair" <%= search&.condition == 'used_fair' ? 'selected' : nil %>>Used fair</option>
      </select>
    </div>
    <div class="field">
      <label>Delivery method</label>
      <select name="delivery_method">
        <option value="">Any</option>
        <option value="all" <%= search&.delivery_method == 'all' ? 'selected' : nil %>>All</option>
        <option value="local_pickup" <%= search&.delivery_method == 'local_pickup' ? 'selected' : nil %>>Local pickup</option>
        <option value="shipping" <%= search&.delivery_method == 'shipping' ? 'selected' : nil %>>Shipping</option>
      </select>
    </div>
    <div class="field">
      <label>Email address<% if email_hint %><span class="label-hint">(<%= escape_html(email_hint) %>)</span><% end %></label>
      <input type="email" name="email" value="<%= escape_html(search&.email || '') %>" required>
    </div>
    <% if active_checkbox && search.respond_to?(:active) %>
      <div class="field field-checkbox">
        <input type="checkbox" name="active" id="active" <%= search.active ? 'checked' : nil %>>
        <label for="active">Active (paused searches are skipped on run)</label>
      </div>
    <% end %>
    <div class="actions">
      <button type="submit" class="button button--primary"><%= escape_html(submit_text) %></button>
      <a href="/searches" class="button button--secondary">Cancel</a>
    </div>
  </form>
</div>
