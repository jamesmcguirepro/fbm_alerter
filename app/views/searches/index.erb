<h1>Searches</h1>

<div class="actions">
  <a href="/searches/new" class="button button--primary">+ Add search</a>
  <% if @show_inactive %>
    <a href="/searches" class="button button--secondary">Hide inactive</a>
  <% else %>
    <a href="/searches?inactive=1" class="button button--secondary">Show inactive</a>
  <% end %>
</div>

<% if @searches.any? %>
<table>
  <thead>
    <tr>
      <th>Name</th><th>Query</th><th>Location</th><th>Price</th><th>Email</th><th>Status</th><th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @searches.each do |search| %>
      <%= erb :'searches/_row', layout: false, locals: { search: search } %>
    <% end %>
  </tbody>
</table>
<% else %>
<div class="empty">
  <% if @show_inactive %>
    No searches saved yet. Add one to get started.
  <% else %>
    No active searches. <a href="/searches?inactive=1">Show inactive</a>.
  <% end %>
</div>
<% end %>
