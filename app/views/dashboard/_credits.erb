<a class="card card--link" id="credits-card" href="https://sociavault.com/dashboard"
   target="_blank" rel="noopener"
   hx-get="/dashboard/credits" hx-trigger="refresh" hx-swap="outerHTML"
   title="Open your SociaVault dashboard">
  <h2>Credits left</h2>
  <% if @credits_error %>
    <div class="value value--danger">—</div>
    <div class="card-note card-note--danger">⚠ can't reach SociaVault</div>
  <% else %>
    <div class="value<%= ' value--low' if low_credits?(@credits) %>"><%= format_number(@credits) %></div>
    <div class="card-note">
      <% if @credits.nil? %>
        no balance returned
      <% elsif low_credits?(@credits) %>
        running low · top up in SociaVault ↗
      <% elsif @credits_status == 'active' %>
        plan active · SociaVault dashboard ↗
      <% else %>
        free account · SociaVault dashboard ↗
      <% end %>
    </div>
  <% end %>
</a>

<div id="credit-chart-card" class="card">
  <h2>Credits trend</h2>
  <% if @credit_chart_data && @credit_chart_data.any? %>
    <div class="credits-trend">
      <canvas id="credit-sparkline" width="200" height="80"></canvas>
      <div class="credits-meta">
        <span class="credits-meta__time">Last 7 days</span>
        <div class="credits-stats">
          <span class="credits-stat">
            <strong><%= CreditSnapshot.average_daily_consumption.round(1) %></strong> credits/day
          </span>
          <% days = CreditSnapshot.days_remaining %>
          <span class="credits-stat credits-stat--<%= days && days < 14 ? 'warn' : 'ok' %>">
            <% if days %>
              <%= days %> days left
            <% else %>
              balance steady
            <% end %>
          </span>
        </div>
      </div>
    </div>
  <% else %>
    <div class="card-note">No balance history yet. Run searches to start tracking.</div>
  <% end %>
</div>

<script>
  (function() {
    var data = <%= @credit_chart_data.map { |ts, balance| [ts.iso8601, balance.to_f] }.to_json %>;
    if (!data.length) return;

    var canvas = document.getElementById('credit-sparkline');
    if (!canvas) return;

    var ctx = canvas.getContext('2d');
    var w = canvas.width, h = canvas.height;
    var pad = { top: 10, right: 32, bottom: 22, left: 32 };
    var chartW = w - pad.left - pad.right;
    var chartH = h - pad.top - pad.bottom;

    var balances = data.map(function(d) { return d[1]; });
    var minBal = Math.min.apply(null, balances);
    var maxBal = Math.max.apply(null, balances);
    var range = maxBal - minBal || 1;

    var stepX = chartW / (data.length - 1 || 1);

    // Y-axis labels
    ctx.fillStyle = '#9ca3af';
    ctx.font = '10px system-ui, sans-serif';
    ctx.textAlign = 'right';
    ctx.fillText(maxBal.toFixed(0), pad.left - 4, pad.top + 4);
    ctx.fillText(minBal.toFixed(0), pad.left - 4, pad.top + chartH);

    // X-axis date labels
    ctx.textAlign = 'center';
    var labelFormat = data.length <= 7 ? 'd' : 'MMM d';
    data.forEach(function(d, i) {
      var x = pad.left + i * stepX;
      var date = new Date(d[0]);
      var label = date.getDate().toString();
      if (data.length > 7) {
        label = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      }
      ctx.fillText(label, x, h - pad.bottom + 14);
    });

    // Line
    ctx.strokeStyle = '#2563eb';
    ctx.lineWidth = 2;
    ctx.beginPath();
    data.forEach(function(d, i) {
      var x = pad.left + i * stepX;
      var y = pad.top + chartH - ((d[1] - minBal) / range) * chartH;
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // Points
    ctx.fillStyle = '#2563eb';
    data.forEach(function(d, i) {
      var x = pad.left + i * stepX;
      var y = pad.top + chartH - ((d[1] - minBal) / range) * chartH;
      ctx.beginPath();
      ctx.arc(x, y, 2, 0, 2 * Math.PI);
      ctx.fill();
    });

    // End dot (latest)
    var last = data[data.length - 1];
    var lx = pad.left + (data.length - 1) * stepX;
    var ly = pad.top + chartH - ((last[1] - minBal) / range) * chartH;
    ctx.fillStyle = '#16a34a';
    ctx.beginPath();
    ctx.arc(lx, ly, 3, 0, 2 * Math.PI);
    ctx.fill();
  })();
</script>
