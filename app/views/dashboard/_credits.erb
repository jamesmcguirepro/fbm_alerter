<a class="card card--link" id="credits-card" href="https://sociavault.com/dashboard"
   target="_blank" rel="noopener"
   hx-get="/dashboard/credits" hx-trigger="refresh" hx-swap="outerHTML"
   title="Open your SociaVault dashboard">
  <h2>Credits left</h2>
  <% if @credits_error %>
    <div class="value" style="color:#b91c1c;">—</div>
    <div style="font-size:0.85rem;color:#b91c1c;">⚠ can't reach SociaVault</div>
  <% else %>
    <div class="value"<%= ' style="color:#b45309;"' if low_credits?(@credits) %>><%= format_number(@credits) %></div>
    <div style="font-size:0.85rem;color:#6b7280;">
      <% if @credits.nil? %>
        no balance returned
      <% elsif low_credits?(@credits) %>
        running low · top up in SociaVault ↗
      <% elsif @credits_status == 'active' %>
        plan active · SociaVault dashboard ↗
      <% else %>
        free account · SociaVault dashboard ↗
      <% end %>
    </div>
  <% end %>
</a>
