<h1>Listings</h1>

<div class="form form--wide">
  <form action="/listings" method="get" class="filter-form">
    <div class="field">
      <label>Search title</label>
      <input type="text" name="query" value="<%= escape_html(@query) %>" placeholder="Filter by title…">
    </div>
    <div class="field">
      <label>Sold</label>
      <select name="sold">
        <option value="">All</option>
        <option value="0" <%= @sold == '0' ? 'selected' : nil %>>Not sold</option>
        <option value="1" <%= @sold == '1' ? 'selected' : nil %>>Sold</option>
      </select>
    </div>
    <button type="submit" class="button button--primary">Filter</button>
    <a href="/listings" class="button button--secondary">Clear</a>
  </form>
</div>

<% if @listings.any? %>
<table>
  <thead>
    <tr>
      <th>Thumbnail</th><th>Title</th><th>Price</th><th>Location</th><th>Search</th><th>Last seen</th><th>Sold</th>
    </tr>
  </thead>
  <tbody>
    <%= erb :'listings/_rows', layout: false, locals: {
      listings: @listings, search_id_by_query: @search_id_by_query, thumbnail: true, run: true
    } %>
  </tbody>
</table>

<div class="pagination">
  <% (1..[@total_pages, 1].max).each do |p| %>
    <% if p == @page %>
      <span class="current"><%= p %></span>
    <% else %>
      <a href="/listings?page=<%= p %><%= qs_extra %>"><%= p %></a>
    <% end %>
  <% end %>
</div>
<% else %>
<div class="empty">No listings yet.</div>
<% end %>
