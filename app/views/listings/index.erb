<h1>Listings</h1>

<div class="form" style="max-width:700px;">
  <form action="/listings" method="get" style="display:flex;gap:0.5rem;align-items:flex-end;">
    <div class="field" style="margin-bottom:0;">
      <label style="display:block;margin-bottom:0.25rem;">Search title</label>
      <input type="text" name="query" value="<%= @query %>" placeholder="Filter by title…">
    </div>
    <div class="field" style="margin-bottom:0;">
      <label style="display:block;margin-bottom:0.25rem;">Sold</label>
      <select name="sold">
        <option value="">All</option>
        <option value="0" <%= @sold == '0' ? 'selected' : nil %>>Not sold</option>
        <option value="1" <%= @sold == '1' ? 'selected' : nil %>>Sold</option>
      </select>
    </div>
    <button type="submit" class="button button--primary">Filter</button>
    <a href="/listings" class="button button--secondary">Clear</a>
  </form>
</div>

<% if @listings.any? %>
<table>
  <thead>
    <tr>
      <th>Thumbnail</th><th>Title</th><th>Price</th><th>Location</th><th>Search</th><th>Last seen</th><th>Sold</th>
    </tr>
  </thead>
  <tbody>
    <% @listings.each do |listing| %>
    <tr<% if listing.url.present? %> data-href="<%= escape_html(listing.url) %>"<% end %>>
      <td><% if listing.image_url %><%= external_link(listing.url, image_tag(listing.image_url, listing.title)) %><% end %></td>
      <td><%= external_link(listing.url, escape_html(truncate(listing.title))) %></td>
      <td class="nowrap"><%= format_price(listing.price) %></td>
      <td><%= listing.location || '—' %></td>
      <td>
        <% sid = @search_id_by_query[listing.search_query] %>
        <% if sid %>
          <a href="/searches?inactive=1#search-row-<%= sid %>"><%= truncate(listing.search_query) %></a>
        <% else %>
          <%= truncate(listing.search_query) %>
        <% end %>
      </td>
      <td class="nowrap"><%= format_date(listing.last_seen_at) %></td>
      <td><%= listing.is_sold ? '✓' : '—' %></td>
    </tr>
    <% end %>
  </tbody>
</table>

<div class="pagination">
  <% (1..[@total_pages, 1].max).each do |p| %>
    <% if p == @page %>
      <span class="current"><%= p %></span>
    <% else %>
      <a href="/listings?page=<%= p %><%= qs_extra %>"><%= p %></a>
    <% end %>
  <% end %>
</div>
<% else %>
<div class="empty">No listings yet.</div>
<% end %>
