<div class="page">
  <h1>Listings</h1>

  <% if @search %>
  <p class="page-note">
    Showing all listings ever returned by
    <strong><%= escape_html(@search.name.presence || @search.query) %></strong><% if @search.name.present? %>
    (<%= escape_html(@search.query) %>)<% end %>.
    <a href="/listings">Show all listings</a>
  </p>
  <% elsif @search_id.present? %>
  <p class="page-note">
    That search no longer exists. <a href="/listings">Show all listings</a>
  </p>
  <% end %>

  <div class="form form--wide">
    <form action="/listings" method="get" class="filter-form">
      <% if @search_id.present? %>
        <input type="hidden" name="search_id" value="<%= escape_html(@search_id) %>">
      <% end %>
      <div class="field">
        <label>Search title</label>
        <input type="text" name="query" value="<%= escape_html(@query) %>" placeholder="Filter by title…">
      </div>
      <div class="field">
        <label>Sold</label>
        <select name="sold">
          <option value="">All</option>
          <option value="0" <%= @sold == '0' ? 'selected' : nil %>>Not sold</option>
          <option value="1" <%= @sold == '1' ? 'selected' : nil %>>Sold</option>
        </select>
      </div>
      <button type="submit" class="button button--primary">Filter</button>
      <a href="<%= @search_id.present? ? "/listings?search_id=#{CGI.escape(@search_id)}" : '/listings' %>"
         class="button button--secondary">Clear</a>
    </form>
  </div>

  <% if @listings.any? %>
  <div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Thumbnail</th><th>Title</th><th>Price</th><th>Location</th><th>Search</th><th>Last seen</th><th>Sold</th>
      </tr>
    </thead>
    <tbody>
      <%= erb :'listings/_rows', layout: false, locals: {
        listings: @listings, search_id_by_query: @search_id_by_query, thumbnail: true, run: true
      } %>
    </tbody>
  </table>
  </div>

  <%= erb :'shared/_pagination', locals: { path: '/listings', page: @page, total_pages: @total_pages, qs_extra: qs_extra } %>
  <% else %>
  <div class="empty">
    <% if @search %>
      No listings returned by this search yet.
    <% elsif @search_id.present? %>
      No listings for that search.
    <% else %>
      No listings yet.
    <% end %>
  </div>
  <% end %>
</div>
