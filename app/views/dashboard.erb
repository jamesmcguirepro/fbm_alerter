<h1>Dashboard</h1>

<div class="grid">
  <a href="/searches" class="card card--link">
    <h2>Saved searches</h2>
    <div class="value"><%= @search_count %></div>
    <div style="font-size:0.85rem;color:#6b7280;"><%= @active_count %> active</div>
  </a>
  <a href="/listings" class="card card--link">
    <h2>Listings seen</h2>
    <div class="value"><%= @listing_count %></div>
  </a>
  <a href="/alerts" class="card card--link">
    <h2>Alerts sent</h2>
    <div class="value"><%= @alert_count %></div>
  </a>
  <a href="/listings" class="card card--link">
    <h2>Last activity</h2>
    <div class="value"><%= format_date(@last_activity) %></div>
  </a>
  <a href="/searches" class="card card--link">
    <h2>API calls</h2>
    <div class="value"><%= @api_call_count %></div>
    <div style="font-size:0.85rem;color:#6b7280;"><%= @api_today_count %> today · 1 credit each</div>
  </a>
  <a class="card card--link" id="credits-card" href="https://sociavault.com/dashboard"
     target="_blank" rel="noopener"
     hx-get="/dashboard/credits" hx-trigger="load, refresh" hx-swap="outerHTML"
     title="Open your SociaVault dashboard">
    <h2>Credits left</h2>
    <div class="value">…</div>
    <div style="font-size:0.85rem;color:#6b7280;">checking SociaVault…</div>
  </a>
</div>

<div class="actions">
  <button hx-post="/dashboard/run-all" hx-target="main" hx-swap="innerHTML" class="button button--primary">
    ▶ Run all searches now
  </button>
</div>

<div id="run-all-log">
  <% unless @log.to_s.strip.empty? %>
    <pre class="run-log"><%= @log %></pre>
  <% end %>
</div>

<h2>Recent listings</h2>
<% if @recent_listings.any? %>
<table>
  <thead>
    <tr>
      <th>Title</th><th>Price</th><th>Location</th><th>Search</th><th>Last seen</th><th>Sold</th>
    </tr>
  </thead>
  <tbody>
    <% @recent_listings.each do |listing| %>
    <tr<% if listing.url.present? %> data-href="<%= escape_html(listing.url) %>"<% end %>>
      <td><%= external_link(listing.url, escape_html(truncate(listing.title))) %></td>
      <td class="nowrap"><%= format_price(listing.price) %></td>
      <td><%= listing.location || '—' %></td>
      <td><%= search_query_link(@search_id_by_query[listing.search_query], listing.search_query) %></td>
      <td class="nowrap"><%= format_date(listing.last_seen_at) %></td>
      <td><%= listing.is_sold ? '✓' : '—' %></td>
    </tr>
    <% end %>
  </tbody>
</table>
<% else %>
<div class="empty">No listings yet. Add a search and run it to start collecting.</div>
<% end %>
